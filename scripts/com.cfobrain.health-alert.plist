<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd job CẢNH BÁO SỨC KHỎE APP — CÀI TRÊN iMAC (user `mac`).
  Chạy scripts/health-alert.sh mỗi 5 phút — bắn Zalo nếu /health fail 2 lần liên tiếp.
  Audit 2026-07-10 mục I / AUDIT-0711-F.

  Cài đặt:
    cp scripts/com.cfobrain.health-alert.plist ~/Library/LaunchAgents/
    launchctl load -w ~/Library/LaunchAgents/com.cfobrain.health-alert.plist

  Sửa đường dẫn nếu app KHÔNG ở /Users/mac/cfobrain.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.cfobrain.health-alert</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/mac/cfobrain/scripts/health-alert.sh</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>CFOBRAIN_DIR</key>
    <string>/Users/mac/cfobrain</string>
    <key>PATH</key>
    <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <!-- Chạy ngay khi nạp, rồi lặp lại mỗi 300 giây (5 phút) -->
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>300</integer>

  <key>StandardOutPath</key>
  <string>/tmp/cfobrain-health-alert.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/cfobrain-health-alert.log</string>
</dict>
</plist>
