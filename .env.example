# ============================================================
# CFO Brain 4.0 — Environment Variables Template
# Sao chép file này thành .env.local và điền giá trị thực
# ============================================================

# --- Supabase (Backend - server.ts) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# --- Supabase (Frontend - Vite components) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# --- Session ---
# Tạo bằng: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your-random-session-secret

# --- Internal API Key (dùng cho /api/sync-kiotviet) ---
# Tạo bằng: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
INTERNAL_API_KEY=your-random-api-key

# --- App URL (dùng cho CORS + Facebook OAuth redirect) ---
# Production: https://your-domain.com
APP_URL=http://localhost:3000

# --- AI ---
GEMINI_API_KEY=your-gemini-api-key
