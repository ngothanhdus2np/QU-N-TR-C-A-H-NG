# Copy file này thành .env.local và điền giá trị thực
# KHÔNG commit .env.local lên git

# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Backend-only. Dùng cho import/sync server-side để bypass RLS; không đưa vào frontend.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase archive project (nếu tạo project thứ 2 để lưu dữ liệu cũ)
SUPABASE_ARCHIVE_URL=https://your-archive-project.supabase.co
SUPABASE_ARCHIVE_ANON_KEY=your-archive-anon-key

# Keep-alive nhiều project. Format:
# name|url|anon_key|table,name2|url2|anon_key2|table2
# Nếu không set dòng này, script sẽ dùng SUPABASE_URL/VITE_SUPABASE_URL và SUPABASE_ARCHIVE_URL.
SUPABASE_KEEPALIVE_TARGETS=

# Session (dùng chuỗi ngẫu nhiên dài ít nhất 32 ký tự)
SESSION_SECRET=your-random-secret-key

# Internal API Key (cho phép KiotViet sync từ bên ngoài)
INTERNAL_API_KEY=your-random-internal-key

# Claude / Anthropic AI
ANTHROPIC_API_KEY=your-anthropic-api-key

# Facebook (điền khi cần dùng tính năng Facebook)
FB_APP_ID=your-facebook-app-id
FB_APP_SECRET=your-facebook-app-secret

# App URL (cho Facebook OAuth callback)
APP_URL=http://localhost:3000

# Email thông báo cuối ngày (Gmail)
# Tạo App Password tại: myaccount.google.com/apppasswords (cần bật 2FA)
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASS=your-gmail-app-password
EMAIL_TO=owner@gmail.com

# Zalo OA thông báo (báo cáo cuối ngày + cảnh báo tự động)
# 1. Đăng ký Zalo OA tại: oa.zalo.me
# 2. Lấy Access Token tại: developers.zalo.me (tab "Quản lý Access Token")
# 3. Lấy Follower ID: follower phải theo dõi OA của bạn trước
ZALO_OA_ACCESS_TOKEN=your-zalo-oa-access-token
ZALO_FOLLOWER_ID=your-zalo-user-id
