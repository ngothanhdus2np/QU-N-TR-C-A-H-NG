  const renderStoreTab = () => (
    <div className="space-y-4">
      <Section
        id="store-profile"
        title="Hồ sơ cửa hàng"
        description="Thông tin này đang dùng cho logo, nội dung Marketing AI và thông tin liên hệ."
        icon={Fingerprint}
      >
        <input
          type="file"
